# ------------------------------------------------------------------
# FoodConnect backend environment variables
# Copy this file to ".env" (same folder) and change the values.
#   Windows:  copy .env.example .env
# NEVER commit your real .env file. These values are for LOCAL DEMOS ONLY.
# ------------------------------------------------------------------

APP_ENV=development

# Secret keys used to sign sessions and login tokens (JWTs).
# Replace with long random strings, e.g. run:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me-secret-key-0f8b7c
JWT_SECRET_KEY=dev-only-change-me-jwt-key-1a2b3c4d5e6f7a8b9c0d

# How long a login lasts (hours)
JWT_EXPIRES_HOURS=8

# Leave empty to use SQLite at backend/instance/foodconnect.db
# Example PostgreSQL URL: postgresql://user:password@localhost:5432/foodconnect
DATABASE_URL=

# Frontend addresses allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Demo accounts created by seed.py (NOT production credentials) ----
DEMO_ADMIN_EMAIL=admin@foodconnect.demo
DEMO_ADMIN_PASSWORD=DemoAdmin@2026
DEMO_USER_PASSWORD=DemoUser@2026
